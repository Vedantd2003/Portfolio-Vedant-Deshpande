
EMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
# Steps: Google Account → Security → 2-Step Verification → App passwords
EMAIL_PASS=your-16-character-app-password

EMAIL_TO=vdeshpande674@gmail.com


# AI chat assistant — Google Gemini (server-only; never prefix with NEXT_PUBLIC_)
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model (defaults to gemini-3.1-flash-lite, falls back to gemini-flash-latest)
# GEMINI_MODEL=
# Optional: set to true to log one Gemini PASS/FAIL check at server start (no key or messages logged)
# GEMINI_SELF_TEST_ON_BOOT=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
